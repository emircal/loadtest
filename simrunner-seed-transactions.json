{
  "connectionString": "mongodb+srv://admin:1234qwer!@cluster0.7pd3e.mongodb.net/",
  "reportInterval": 10000,
  "http": {
    "enabled": false,
    "port": 3000,
    "host": "localhost"
  },
  "dictionaries": {
    "txAccountIds": {
      "file": "model/tx-account-ids.txt",
      "type": "text"
    }
  },
  "templates": [
    {
      "name": "transactions",
      "database": "simrunner",
      "collection": "transactions",
      "template": {
        "transactionId": {
          "%stringConcat": {
            "of": [
              "TXN",
              {
                "%toString": {
                  "of": "%sequence"
                }
              }
            ],
            "sep": ""
          }
        },
        "accountId": {
          "%dictionaryAt": {
            "from": "txAccountIds",
            "at": {
              "%mod": {
                "of": "%sequence",
                "by": 1280872
              }
            }
          }
        },
        "recordType": {
          "%oneOf": {
            "options": [
              1,
              2
            ]
          }
        },
        "transactionDetails": {
          "postDate": {
            "%date": {
              "min": {
                "$date": "2024-01-01"
              },
              "max": {
                "$date": "2026-12-31"
              }
            }
          },
          "effectiveDate": {
            "%date": {
              "min": {
                "$date": "2024-01-01"
              },
              "max": {
                "$date": "2026-12-31"
              }
            }
          },
          "amount": {
            "%decimal": {
              "min": -5000,
              "max": 5000
            }
          },
          "currency": {
            "%oneOf": {
              "options": [
                "USD",
                "EUR",
                "GBP"
              ]
            }
          },
          "description": "%lorem.sentence",
          "mcc": {
            "%number": {
              "min": 1000,
              "max": 9999
            }
          },
          "type": {
            "%oneOf": {
              "options": [
                "PURCHASE",
                "REFUND",
                "WITHDRAWAL"
              ]
            }
          }
        },
        "audit": {
          "uuid": "%uuidString",
          "rts": {
            "%date": {
              "min": {
                "$date": "2024-01-01"
              },
              "max": {
                "$date": "2026-12-31"
              }
            }
          },
          "agent": {
            "%stringConcat": {
              "of": [
                "AGENT_",
                {
                  "%stringTemplate": {
                    "template": "&&&&"
                  }
                }
              ],
              "sep": ""
            }
          }
        }
      }
    }
  ],
  "workloads": [
    {
      "name": "Seed transactions (10-500 per account)",
      "template": "transactions",
      "op": "insert",
      "threads": 2,
      "batch": 4,
      "stopAfter": 160109
    }
  ]
}
